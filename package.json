{
  "name": "gather-livekit-slice",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --env-file-if-exists=.env.local --import tsx server/dev-server.ts\" \"vite --config apps/web/vite.config.ts\"",
    "dev:livekit": "livekit-server --dev",
    "dev:api": "node --env-file-if-exists=.env.local --import tsx server/dev-server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "express": "^5.1.0",
    "livekit-client": "^2.15.6",
    "livekit-server-sdk": "^2.13.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
